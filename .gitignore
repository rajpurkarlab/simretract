# large data and outputs (download or regenerate; see data/README.md and checkpoints/README.md)
data/raw/
data/cache/
checkpoints/*/
/runs/
/eval/
*.safetensors
*.pt
*.tar

# machine-specific configuration written by envs/setup.sh (interpreters, tool_source)
configs/envs.local.yaml

# third-party tool asset: never tracked, built locally from the user's licensed
# copy by `simretract-build-assets` (docs/ASSETS.md). The asset folder is
# dropped under assets/source/<pack>/ as downloaded (only the README there is
# tracked); under assets/tools/<tool>/ only meta.json is tracked (no geometry).
assets/source/*
!assets/source/README.md
assets/tools/*/visual.obj
assets/tools/*/collision/
assets/tools/**/*.obj
assets/tools/**/*.fbx
assets/tools/**/*.stl
assets/tools/**/*.glb
assets/tools/**/*.gltf
assets/tools/**/*.ply
assets/tools/**/*.blend
assets/tools/**/*.max
assets/tools/**/*.step
assets/tools/**/*.stp
assets/tools/**/*.usd
assets/tools/**/*.usda
assets/tools/**/*.usdc
assets/tools/**/*.usdz
assets/tools/**/*.mtl
assets/tools/**/*.png
assets/tools/**/*.jpg
assets/tools/**/*.jpeg
assets/tools/**/*.tga
assets/tools/**/*.tif
assets/tools/**/*.tiff
assets/tools/**/*.bmp
assets/tools/**/*.exr
assets/tools/**/textures/
assets/usd/
# local grasp annotations
assets/tools/*/canonical_slots.json
# source packs, CAD exports, scans and scene files never belong in the
# repository at all, wherever they are dropped; the only tracked meshes are
# the attributed gripper OBJ exports under assets/gripper/
*.fbx
*.blend
*.max
*.ply
*.stl
*.glb
*.gltf
*.usd
*.usda
*.usdc
*.usdz
*.obj
!assets/gripper/**/*.obj

# python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# third-party build directories
third_party/**/build/
third_party/**/__pycache__/

# local scratch
*.log
smoke_tmp/
